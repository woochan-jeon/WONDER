// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // JSON-encoded string[] of freeform team-member names — the workspace has
  // no accounts, so assignees are just names, not linked records.
  assigneeNames String @default("[]")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Slack channel this task should post updates to, picked per-task.
  slackChannelId   String?
  slackChannelName String?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#611f69")
  createdAt DateTime @default(now())

  tasks Task[]
}

// Singleton row: the team's shared Google Calendar connection.
model CalendarConnection {
  id           String   @id @default(cuid())
  googleEmail  String
  // JSON-encoded string[] of calendar IDs shown together in # 캘린더.
  calendarIds  String   @default("[\"primary\"]")
  // Drive folder the # 드라이브 channel is scoped to. Null means "My Drive" root.
  driveRootFolderId   String?
  driveRootFolderName String?
  // Spreadsheet the # 마케팅 channel syncs to. Created automatically on first sync.
  marketingSheetId String?
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  updatedAt    DateTime @updatedAt
}

// Singleton row: the team's Slack workspace connection (bot token from OAuth).
model SlackConnection {
  id          String   @id @default(cuid())
  teamName    String
  teamId      String
  botUserId   String
  accessToken String
  createdAt   DateTime @default(now())
}

// Singleton row: the team-shared flowboard canvas. Stored as one JSON blob
// (projects/tasks/markers/pan/zoom) since the whole board is saved wholesale
// from the client canvas rather than queried field-by-field.
model FlowBoard {
  id        String   @id @default(cuid())
  stateJson String
  updatedAt DateTime @updatedAt
}

enum WorkLogStatus {
  DONE
  PLANNED
}

// A selectable identity for # 업무일지 entries. There's no login/account system
// in this app, so this is just a display-name registry (picked client-side
// and remembered per browser), not a real user record.
model WorkLogMember {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  entries WorkLogEntry[]
}

// One day's freeform note from one member in # 업무일지, mirroring the team's
// old per-person calendar spreadsheet (검정 = done, 파랑 = planned).
model WorkLogEntry {
  id        String        @id @default(cuid())
  date      DateTime
  content   String
  status    WorkLogStatus @default(PLANNED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberId String
  member   WorkLogMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([memberId, date])
}

// A managed category (e.g. JM/Q10/창동) # 일정 entries are filed under —
// same idea as WorkLogMember, but for locations/teams instead of people, and
// freely addable/removable rather than picked from a fixed roster.
model ScheduleCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#0066cc")
  createdAt DateTime @default(now())

  entries ScheduleEntry[]
}

// One item in # 일정, rendered as a continuous bar from `date` to `endDate`
// (same value for a single-day item) and colored by its category rather than
// by a done/planned status.
model ScheduleEntry {
  id        String   @id @default(cuid())
  date      DateTime
  endDate   DateTime
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   ScheduleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId, date])
}

// Shared team credentials for # 비밀번호. Gated behind a passphrase at the page
// level (see src/lib/password-gate.ts) since the workspace itself has no login.
model PasswordEntry {
  id        String   @id @default(cuid())
  service   String
  account   String?
  password  String
  note      String?
  sourceUrl String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A marketing budget owner for # 마케팅 — currently 큐텐/쇼피 (each run by a
// different outsourced operator), but kept as a managed list like Category
// since more storefronts/projects may be added later.
model MarketingProject {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#0066cc")
  // ISO code (KRW/JPY/SGD, see src/lib/currency.ts). All of this project's
  // budget and expense amounts are in this currency.
  currency  String   @default("KRW")
  createdAt DateTime @default(now())

  budgets    MarketingBudget[]
  expenses   MarketingExpense[]
  categories MarketingCategory[]
}

// A spend category within one MarketingProject (e.g. 큐텐의 "광고비"/"인플루언서"),
// so # 마케팅 can break down status/spend below the project level. Scoped to a
// single project since 큐텐/쇼피 are run by different operators with different
// category schemes.
model MarketingCategory {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#0066cc")
  createdAt DateTime @default(now())

  projectId String
  project   MarketingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  expenses MarketingExpense[]
  budgets  MarketingBudget[]

  @@unique([projectId, name])
}

// One project's (or, optionally, one category's) target spend for a given
// month, shown against actual MarketingExpense totals in # 마케팅. A row with
// categoryId = null is the project-wide target; a row with categoryId set is
// a target scoped to that category, so budgets can be broken down the same
// way expenses already are.
model MarketingBudget {
  id        String   @id @default(cuid())
  year      Int
  month     Int // 1-12
  amount    Float // in the project's currency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   MarketingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryId String?
  category   MarketingCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([projectId, categoryId, year, month])
}

enum MarketingExpenseKind {
  CASH
  SALES_DEDUCTION
  IN_KIND
}

// One marketing spend line item for # 마케팅 — which channel it ran on, what
// was done, how much it cost, and how it was paid.
model MarketingExpense {
  id            String   @id @default(cuid())
  date          DateTime
  channel       String
  description   String
  amount        Float // in the project's currency; for IN_KIND, quantity × unitCost
  // See src/lib/marketing-expense-kind.ts: CASH = money paid out,
  // SALES_DEDUCTION = taken out of sales at settlement, IN_KIND = non-cash
  // cost such as product samples, valued at cost (원가). Each kind can be
  // toggled in/out of the totals in # 마케팅.
  kind          MarketingExpenseKind @default(CASH)
  itemName      String? // IN_KIND only
  quantity      Int? // IN_KIND only
  unitCost      Float? // IN_KIND only, per-unit cost in the project's currency
  paymentMethod String
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectId String
  project   MarketingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryId String?
  category   MarketingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([projectId, date])
}

// A manually set KRW-per-unit exchange rate for # 마케팅. Without a row the
// live rate (see src/lib/exchange-rates.ts) is used, so a row only exists
// once someone has overridden the default.
model MarketingExchangeRate {
  currency  String   @id
  rate      Float
  updatedAt DateTime @updatedAt
}

// Curated agenda/decision summaries for the # 회의 아카이브 channel, sourced from
// the Gemini-generated meeting minutes in the Drive "Meet Recordings" folder.
model MeetingSummary {
  id          String   @id @default(cuid())
  driveFileId String   @unique
  meetingDate DateTime
  title       String
  // JSON-encoded { agenda: string, decision: string | null }[] — each agenda
  // item is paired inline with its decision (or null if still undecided).
  itemsJson   String
  sourceUrl   String?
  createdAt   DateTime @default(now())
}


// A person tracked in # 장관인증요건. Like WorkLogMember this is just a name
// registry (no accounts); the simple yes/no conditions live on the row itself.
// GPA is stored only as "met or not" — the actual grade is deliberately never
// collected (the in-page GPA calculator doesn't save its inputs either).
model CertMember {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GPA is met by either route: cumulative (all semesters) ≥ 3.7, or the
  // current semester (1학기 or 2학기) alone ≥ 4.1.
  gpaOk                Boolean   @default(false) // cumulative route
  gpaCheckedAt         DateTime?
  gpaSemesterOk        Boolean   @default(false) // current-semester route
  gpaSemesterCheckedAt DateTime?
  // GTEP 프로그램 수료. The 80h personal exhibition log (CertExhibition) is
  // one of its requirements and is shown as progress toward it.
  gtepCompleted   Boolean   @default(false)
  gtepCompletedAt DateTime?

  // 협력업체 특화지역 시장진출보고서 — everyone has submitted it by default.
  reportSubmitted Boolean   @default(true)

  // 소속팀 성과, pick one: export (contract + US$2,000) or e-commerce
  // practice (a product listed & sold + a marketing analysis report).
  teamExportContract Boolean @default(false) // 계약체결 1건 이상
  teamExportAmount   Boolean @default(false) // 수출실적 US$2,000 이상
  teamEcomSale       Boolean @default(false) // 상품 등록 및 판매 1건 이상
  teamEcomReport     Boolean @default(false) // 마케팅 분석보고서 1건 이상

  certCustomsBroker1 Boolean @default(false) // 관세사 1차 (path A, pick one)
  certGukmusa1      Boolean @default(false) // 국제무역사 1급 (path A, pick one)
  certForexManager  Boolean @default(false) // 외환관리사 (path A, pick one)
  certFtaOrigin     Boolean @default(false) // FTA 원산지관리사 (path A, pick one)
  certBondedAgent   Boolean @default(false) // 보세사 (path A, pick one)
  certTradeEnglish1 Boolean @default(false) // 무역영어 1급 (path B, required)
  certLogistics     Boolean @default(false) // 물류관리사 (path B, pick one)
  certDistribution1 Boolean @default(false) // 유통관리사 1급 (path B, pick one)
  certDistribution2 Boolean @default(false) // 유통관리사 2급 (path B, pick one)
  certImportManager Boolean @default(false) // 수입관리사 (path B, pick one)

  langScores  CertLangScore[]
  exhibitions CertExhibition[]
}

// One registered language test result. `exam` is an exam id from
// src/lib/minister-cert.ts; `grade` holds the grade/level option for
// grade-based exams and `score` the numeric score where the exam needs one.
// The TOEIC-equivalent verdict is computed from the conversion table on read,
// not stored, so table/threshold changes apply retroactively.
model CertLangScore {
  id        String   @id @default(cuid())
  exam      String
  grade     String?
  score     Int?
  createdAt DateTime @default(now())

  memberId String
  member   CertMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

enum CertExhibitionLocation {
  DOMESTIC
  OVERSEAS
}

// One personal exhibition participation counted toward the 80-hour GTEP
// requirement in # 장관인증요건.
model CertExhibition {
  id        String                 @id @default(cuid())
  name      String
  location  CertExhibitionLocation
  startDate DateTime
  endDate   DateTime
  hours     Float
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  memberId String
  member   CertMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}
